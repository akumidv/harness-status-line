# Generic. Each component keeps its own rules in <component>/.gitignore.
__pycache__/
.DS_Store
*.bak
*.bak-*
# Runtime state, caches and secrets of the deployed tools never come back into the repo.
.env
*.local.json

# Local working notes (checkpoints, handoffs): never committed.
_aitna/.local/

# secrets
*.env
!*.env.example

# dev-layer venv (provisioned only when the project has no Python environment)
_aitna/.venv/

# local layer (machine state), ergons, worktrees and scratch — never committed
_aitna/.ergon/
.worktrees/
.tmp/

# akmon model routing — per-user/per-session artifacts (never committed)
.claude/model-routing.local.json
.claude/model-routing.log
.claude/second-opinion/
.codex/second-opinion/
.qwen/second-opinion/
.opencode/second-opinion/
.pi/second-opinion/
.claude/agents/k_*.md

# Python dev environment (akmon package)
.venv/

{
  "id": "root",
  "theme": "ai-env",
  "cloned_from": {
    "name": "main",
    "version": "0.1.18"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "sidebar-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "space-tree"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agent-list"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "sidebar-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "tab-bar"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              },
              "size": {
                "weight": 3
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-tabs",
                  "type": "block",
                  "size": {
                    "px": 34
                  },
                  "content": {
                    "mod": "panel-tabs"
                  }
                },
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "git-panel"
                      }
                    },
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "file-panel"
                      }
                    }
                  ],
                  "active": "changes",
                  "size": {
                    "weight": 3
                  }
                },
                {
                  "id": "panel-shell",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-shell-bar",
                      "type": "block",
                      "content": {
                        "mod": "panel-shell"
                      },
                      "size": {
                        "px": 32
                      }
                    },
                    {
                      "id": "panel-shell-term",
                      "type": "stack",
                      "children": []
                    }
                  ],
                  "size": {
                    "weight": 2
                  },
                  "min": 80,
                  "background": "surface",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "radius": 10
                }
              ],
              "size": {
                "weight": 2
              },
              "min": 320,
              "max": 2400,
              "gap": 8
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "status-bar"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "link_handlers": [
    "file-panel"
  ]
}
